#!/bin/sh
# Refuse commits that would put money amounts in git history. Install once per account repo:
#   ln -sf ~/.claude/skills/portfolio-tracker/scripts/pre-commit .git/hooks/pre-commit
if git diff --cached --name-only | grep -qE '^private/|\.env$'; then
  echo "pre-commit: private/ files (money amounts, API keys) and *.env files must not be committed." >&2; exit 1
fi
# The account's currency symbol or code followed by digits (e.g. Rs 5, PKR5, $5, USD 5),
# or amounts with thousands separators (million or lakh style).
CUR=$(python3 -I -c 'import json, re; c = json.load(open("portfolio.json"))["currency"]; print("(%s\\.?|%s) ?[0-9]" % (re.escape(c["symbol"]), re.escape(c["code"])))') || {
  echo "pre-commit: could not read currency from portfolio.json; refusing to commit unchecked." >&2; exit 1
}
PAT="$CUR"'|\b[0-9]{1,3}(,[0-9]{3}){2,}\b|\b[0-9]{1,2},[0-9]{2},[0-9]{3}\b'
if git diff --cached -U0 | grep '^+[^+]' | grep -qE "$PAT"; then
  echo "pre-commit: staged changes look like they contain money amounts. Keep amounts in private/ only." >&2
  git diff --cached -U0 | grep '^+[^+]' | grep -nE "$PAT" | cut -c1-80 >&2
  exit 1
fi
